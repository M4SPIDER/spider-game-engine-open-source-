{
  "name": "spider-engine",
  "version": "0.9.0",
  "description": "Spider Engine - React based game engine",
  "author": "M4SPIDER <support@m4spider.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:game": "vite build --config vite.game.config.mjs && node scripts/copy-game-html.cjs",
    "tauri:build": "tauri build --no-bundle",
    "tauri:dev": "tauri dev",
    "game:export": "node scripts/export-level.cjs",
    "electron": "electron .",
    "electron:dev": "electron .",
    "electron dev": "electron .",
    "electron:built": "electron . --built",
    "start": "vite",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "chess.js": "^1.4.0",
    "electron-context-menu": "^5.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.m4spider.engine",
    "productName": "Spider Engine",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "directories": {
      "output": "C:/Users/vvvr8/AppData/Local/Temp/spider/spider-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "homepage": "https://github.com/M4SPIDER/spider-game-engine-open-source-",
